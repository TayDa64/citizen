{
  "name": "citizen",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Citizen - Civic + Startup simulation game with real-world triggers",
  "engines": {
    "node": ">=22.22.2"
  },
  "dependencies": {
    "@highcharts/react": "^5.0.0",
    "@xyflow/react": "^12.0.0",
    "highcharts": "^13.0.0",
    "pg": "^8.23.1",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@vitejs/plugin-react": "^4.0.0",
    "jsdom": "^30.1.3",
    "vite": "^5.0.0",
    "vitest": "^3.2.7"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start:api": "node server/index.js",
    "ingest:once": "node server/ingestOnce.js",
    "calendar:clock": "node server/dueRowSweep.js",
    "fetch:allowlisted": "node server/allowlistedFetch.js",
    "test:unit": "node --test test/unit/*.api.js",
    "test:ui": "vitest run",
    "test": "npm run test:unit && npm run test:ui",
    "test:api": "node --test test/api/*.api.js",
    "check:restack": "node --test test/model/campaign-restack-atomicity.api.js",
    "test:browser": "playwright test"
  }
}
